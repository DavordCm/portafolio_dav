---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html { scroll-behavior: smooth; }

  :root {
    --bg:       #0d0a18;
    --bg2:      #140e24;
    --card:     #120c20;
    --green:    #b44aff;
    --green-dim:#9333ea;
    --green-dk: #581c87;
    --text:     #e0d4f0;
    --text-dim: #8a6aae;
    --border:   #2d1a50;
    --glow:     rgba(180, 74, 255, 0.40);
  }

  body {
    font-family: 'Courier New', monospace;
    background-color: var(--bg);
    color: var(--text);
    background-image:
      linear-gradient(rgba(45, 26, 80, 0.30) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 26, 80, 0.30) 1px, transparent 1px);
    background-size: 32px 32px;
    overflow-x: hidden;
  }

  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--green-dk); }

  a { color: inherit; text-decoration: none; }

  .pf { font-family: 'Press Start 2P', monospace; }

  .neon {
    color: var(--green);
    text-shadow: 0 0 8px var(--glow), 0 0 16px var(--glow);
  }

  .highlight {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Animations --- */
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }
  @keyframes glitch {
    0%,89%,100% { transform: translate(0); }
    90%  { transform: translate(-2px, 1px); }
    92%  { transform: translate(2px, -1px); }
    94%  { transform: translate(-1px, 2px); }
    96%  { transform: translate(0); }
  }
  @keyframes xpfill {
    from { width: 0; }
  }
  @keyframes fadeup {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse-border {
    0%,100% { box-shadow: 0 0 8px var(--glow), inset 0 0 8px rgba(180,74,255,0.05); }
    50%     { box-shadow: 0 0 20px var(--glow), 0 0 40px var(--glow), inset 0 0 16px rgba(180,74,255,0.08); }
  }
  @keyframes scanmove {
    0%   { top: -6px; }
    100% { top: 100%; }
  }
</style>
