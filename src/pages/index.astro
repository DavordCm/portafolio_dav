---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: "01",
    title: "AKTIVA ENERGY BARS",
    stack: ["React 19", "Node.js", "Express", "MySQL"],
    desc: "E-commerce completo con sistema de roles, pagos integrados, panel administrativo y deploy en Netlify.",
    year: "2025",
    link: "https://projecto-aktiva.netlify.app/"
  },
  {
    id: "02",
    title: "LAVAYA",
    stack: ["React", "Tailwind CSS", "Firebase", "Netlify"],
    desc: "Web para servicio de lavandería express. Proyecto real para cliente — desarrollo de UI, estructura web y deploy en la nube.",
    year: "2025",
    link: "https://lavaya.netlify.app/"
  },
  {
    id: "03",
    title: "FISCALIZACIÓN VEHICULAR",
    stack: ["React", "Spring Boot", "Node.js", "MySQL", "JWT"],
    desc: "Sistema web con autenticación JWT, API REST y panel de gestión para control vehicular.",
    year: "2025",
    link: "#"
  },
  {
    id: "04",
    title: "GESTIÓN DE MULTAS",
    stack: ["C#", "ASP.NET", "SQL Server"],
    desc: "Sistema de gestión de multas e infracciones con CRUD completo, reportes y base de datos relacional.",
    year: "2024",
    link: "#"
  },
];

const skillGroups = [
  {
    label: "DOMINO",
    skills: ["React", "JavaScript", "Node.js", "Express", "MySQL", "HTML/CSS", "Git"],
  },
  {
    label: "EXPERIENCIA",
    skills: ["Spring Boot", "Angular", "TypeScript", "SQL Server", "Firebase", "Tailwind CSS"],
  },
  {
    label: "CONOCIMIENTOS",
    skills: ["C#", "ASP.NET", "Python", "Docker", "MongoDB"],
  },
];
---

<Layout title="DAVOR_POLLERI // PORTFOLIO_OS v1.0">

  <!-- ========== SCANLINES OVERLAY ========== -->
  <div class="scanlines" aria-hidden="true"></div>

  <!-- ========== NAVBAR ========== -->
  <nav class="navbar">
    <div class="nav-logo pf">PORTFOLIO</div>
    <ul class="nav-links">
      <li><a href="#home" class="nav-link active pf">INICIO</a></li>
      <li><a href="#quests" class="nav-link pf">PROYECTOS</a></li>
      <li><a href="#stats" class="nav-link pf">SKILLS</a></li>
      <li><a href="#contact" class="nav-link pf">CONTACTO</a></li>
    </ul>
    <div class="nav-icon pf">&#9608;</div>
  </nav>

  <!-- ========== HERO ========== -->
  <section id="home" class="hero">
    <div class="hero-content">
      <div class="level-badge pf">FULL_STACK_DEVELOPER</div>
      <h1 class="hero-title pf">
        DAVOR <span class="neon">POLLERI LLALLERI</span>
      </h1>
      <p class="hero-desc">
        Desarrollo aplicaciones web completas — del diseño al deploy.
        Trabajo con <span class="highlight">React</span>,
        <span class="highlight">Node.js</span> y <span class="highlight">MySQL</span>.
        Egresado en Desarrollo de Sistemas (IDAT) y actualmente cursando
        <span class="highlight">Ingeniería de Sistemas en la UPC</span>.
        Con proyectos reales en producción con pagos integrados,
        sistema de roles y paneles administrativos.
      </p>
      <div class="hero-buttons">
        <a href="#quests" class="btn btn-primary pf">VIEW QUESTS &rarr;</a>
        <a href="#contact" class="btn btn-secondary pf">HIRE ME &#9889;</a>
      </div>
      <div class="breadcrumb pf">
        <span>ROOT</span>
        <span class="sep">&#9654;</span>
        <span>SOURCE</span>
        <span class="sep">&#9654;</span>
        <span class="neon">HERO_MAIN.ROM</span>
      </div>
    </div>

    <div class="hero-avatar">
      <div class="avatar-frame">
        <div class="avatar-inner">
          <img
            src="/avatar2.jpg"
            alt="Davor Polleri"
            style="width:100%;height:100%;object-fit:cover;image-rendering:pixelated;filter:contrast(1.1) saturate(0.85);"
          />
        </div>
        <span class="corner tl"></span>
        <span class="corner tr"></span>
        <span class="corner bl"></span>
        <span class="corner br"></span>
      </div>
      <div class="status-badge pf">
        <span class="status-dot"></span>
        STATUS<br/>
        <span class="neon">DISPONIBLE // LIMA, PE</span>
      </div>
    </div>
  </section>

  <!-- ========== STATS PREVIEW ========== -->
  <section class="stats-preview">
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label pf">PROYECTOS_EN_PRODUCCIÓN</span>
      </div>
      <div class="stat-value pf neon">4+</div>
      <p class="stat-desc">Aplicaciones web desplegadas y funcionando para clientes reales.</p>
    </div>
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label pf">TECNOLOGÍAS</span>
      </div>
      <div class="stat-value pf neon">10+</div>
      <p class="stat-desc">Frontend, backend, bases de datos y herramientas de deploy.</p>
    </div>
    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label pf">FORMACIÓN</span>
      </div>
      <div class="stat-value pf neon">2</div>
      <p class="stat-desc">Carreras técnicas — IDAT (egresado) y UPC (en curso).</p>
    </div>
  </section>

  <!-- ========== QUESTS / PROJECTS ========== -->
  <section id="quests" class="section">
    <div class="section-header">
      <div class="section-tag pf">// MIS_PROYECTOS</div>
      <h2 class="section-title pf">PROYECTOS</h2>
      <p class="section-sub">Aplicaciones reales desplegadas en producción.</p>
    </div>
    <div class="quests-grid">
      {projects.map((p) => (
        <a href={p.link} target="_blank" rel="noopener" class="quest-card" style={p.link === '#' ? 'pointer-events:none' : ''}>
          <div class="quest-top">
            <span class="quest-id pf">{p.id}</span>
            <span class="quest-year pf">{p.year}</span>
          </div>
          <h3 class="quest-title pf">{p.title}</h3>
          <p class="quest-desc">{p.desc}</p>
          <div class="quest-stack">
            {p.stack.map((tech) => (
              <span class="tech-tag pf">{tech}</span>
            ))}
          </div>
          {p.link !== '#' && <span class="quest-link pf neon">VER DEMO →</span>}
        </a>
      ))}
    </div>
  </section>

  <!-- ========== SKILLS ========== -->
  <section id="stats" class="section">
    <div class="section-header">
      <div class="section-tag pf">// TECNOLOGÍAS</div>
      <h2 class="section-title pf">SKILLS</h2>
      <p class="section-sub">Herramientas con las que trabajo día a día.</p>
    </div>
    <div class="skills-groups">
      {skillGroups.map((group) => (
        <div class="skill-group">
          <h3 class="skill-group-label pf">{group.label}</h3>
          <div class="skill-tags">
            {group.skills.map((skill) => (
              <span class="skill-tag pf">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ========== CONTACT ========== -->
  <section id="contact" class="section">
    <div class="section-header">
      <div class="section-tag pf">// CONTACTO</div>
      <h2 class="section-title pf">CONTÁCTAME</h2>
      <p class="section-sub">¿Tienes un proyecto en mente? Hablemos.</p>
    </div>
    <div class="contact-container">
      <div class="contact-info">
        <div class="ci-item pf">
          <span class="ci-lbl">EMAIL</span>
          <a href="mailto:Davorpolleri.21@outlook.com" class="ci-val neon">Davorpolleri.21@outlook.com</a>
        </div>
        <div class="ci-item pf">
          <span class="ci-lbl">GITHUB</span>
          <a href="https://github.com/DavordCm" target="_blank" class="ci-val neon">@DavordCm</a>
        </div>
        <div class="ci-item pf">
          <span class="ci-lbl">LINKEDIN</span>
          <a href="https://www.linkedin.com/in/davor-polleri-llalleri/" target="_blank" class="ci-val neon">in/davor-polleri-llalleri</a>
        </div>
        <div class="ci-item pf">
          <span class="ci-lbl">STATUS</span>
          <span class="ci-val neon">DISPONIBLE</span>
        </div>
      </div>
      <form class="contact-form" name="contacto" method="POST" data-netlify="true">
        <div class="form-group">
          <label class="form-label pf">NOMBRE</label>
          <input type="text" name="nombre" class="form-input" placeholder="> Tu nombre..." required />
        </div>
        <div class="form-group">
          <label class="form-label pf">EMAIL</label>
          <input type="email" name="email" class="form-input" placeholder="> tu@email.com" required />
        </div>
        <div class="form-group">
          <label class="form-label pf">MENSAJE</label>
          <textarea name="mensaje" class="form-input form-textarea" placeholder="> Escribe tu mensaje..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary pf">ENVIAR MENSAJE &#9889;</button>
      </form>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer class="footer">
    <div class="pf ft-left">&#169;2024 DAVOR_POLLERI_GB</div>
    <div class="ft-links">
      <a href="https://github.com/DavordCm" target="_blank" class="ft-link pf">GITHUB</a>
      <a href="https://www.linkedin.com/in/davor-polleri-llalleri/" target="_blank" class="ft-link pf">LINKEDIN</a>
      <a href="#" class="ft-link pf">DEBUG</a>
    </div>
    <div class="pf ft-right">BATTERY: 94% // SIGNAL: HIGH</div>
  </footer>

</Layout>

<script>
  // Active nav link on scroll & click
  const sections = document.querySelectorAll('section[id], .hero');
  const navLinks = document.querySelectorAll('.nav-link');

  // Click handler
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      navLinks.forEach(l => l.classList.remove('active'));
      link.classList.add('active');
    });
  });

  // Scroll handler
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinks.forEach(l => {
          l.classList.remove('active');
          if (l.getAttribute('href') === `#${id}`) {
            l.classList.add('active');
          }
        });
      }
    });
  }, { threshold: 0.35 });

  sections.forEach(s => { if (s.id) observer.observe(s); });
</script>

<!-- ========================================= -->
<!--                 STYLES                    -->
<!-- ========================================= -->
<style>
  /* ---------- SCANLINES ---------- */
  .scanlines {
    position: fixed; inset: 0;
    background: repeating-linear-gradient(
      0deg, transparent, transparent 2px,
      rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }
  .scanlines::after {
    content: '';
    position: absolute;
    left: 0; width: 100%; height: 6px;
    background: rgba(180,74,255,0.06);
    animation: scanmove 4s linear infinite;
  }

  /* ---------- NAVBAR ---------- */
  .navbar {
    position: fixed; top: 0; left: 0; right: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: .75rem 2rem;
    background: rgba(13,10,24,0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
    z-index: 100;
  }
  .nav-logo { font-size: .65rem; color: var(--text); letter-spacing: 1px; }
  .nav-links {
    display: flex; gap: 1.5rem; list-style: none;
  }
  .nav-link {
    font-size: .45rem; color: var(--text-dim);
    padding: .4rem .6rem;
    transition: color .2s, text-shadow .2s;
    letter-spacing: 1px;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--green);
    text-shadow: 0 0 8px var(--glow);
  }
  .nav-icon { font-size: .5rem; color: var(--text-dim); cursor: pointer; }

  /* ---------- HERO ---------- */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: space-between;
    padding: 6rem 4rem 3rem;
    gap: 3rem;
  }
  .hero-content { flex: 1; max-width: 600px; }

  .level-badge {
    display: inline-block;
    font-size: .4rem;
    padding: .35rem .7rem;
    border: 1px solid var(--green);
    color: var(--green);
    margin-bottom: 1.2rem;
    letter-spacing: 1px;
  }
  .hero-title {
    font-size: 2.8rem;
    line-height: 1.15;
    margin-bottom: 1.2rem;
    animation: glitch 6s infinite;
  }
  .hero-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 2rem;
    border-left: 3px solid var(--green-dk);
    padding-left: 1rem;
  }
  .hero-buttons { display: flex; gap: 1rem; margin-bottom: 2.5rem; }

  .btn {
    display: inline-block;
    padding: .85rem 1.6rem;
    font-size: .45rem;
    border: 2px solid var(--green);
    color: var(--green);
    transition: all .25s;
    cursor: pointer;
    background: transparent;
    letter-spacing: 1px;
  }
  .btn-primary {
    background: rgba(180,74,255,0.08);
  }
  .btn-primary:hover {
    background: var(--green);
    color: var(--bg);
    box-shadow: 0 0 20px var(--glow), 0 0 40px var(--glow);
  }
  .btn-secondary:hover {
    background: rgba(180,74,255,0.12);
    box-shadow: 0 0 12px var(--glow);
  }

  .breadcrumb {
    font-size: .35rem;
    color: var(--text-dim);
    display: flex; align-items: center; gap: .5rem;
  }
  .breadcrumb .sep { color: var(--green-dk); font-size: .3rem; }

  /* ---------- HERO AVATAR ---------- */
  .hero-avatar {
    position: relative;
    flex-shrink: 0;
  }
  .avatar-frame {
    position: relative;
    width: 280px; height: 310px;
    border: 2px solid var(--green);
    background: var(--card);
    overflow: hidden;
    animation: pulse-border 4s ease-in-out infinite;
  }
  .avatar-inner {
    width: 100%; height: 100%;
    background: var(--bg2);
  }
  .avatar-inner img {
    display: block;
  }

  /* corner decorations */
  .corner {
    position: absolute;
    width: 12px; height: 12px;
    border-color: var(--green);
    border-style: solid;
  }
  .corner.tl { top: -2px; left: -2px; border-width: 3px 0 0 3px; }
  .corner.tr { top: -2px; right: -2px; border-width: 3px 3px 0 0; }
  .corner.bl { bottom: -2px; left: -2px; border-width: 0 0 3px 3px; }
  .corner.br { bottom: -2px; right: -2px; border-width: 0 3px 3px 0; }

  .status-badge {
    position: absolute;
    bottom: -10px; right: -20px;
    font-size: .32rem;
    background: var(--card);
    border: 1px solid var(--green);
    padding: .5rem .7rem;
    line-height: 1.8;
    color: var(--text-dim);
  }
  .status-dot {
    display: inline-block;
    width: 6px; height: 6px;
    background: var(--green);
    border-radius: 50%;
    margin-right: .3rem;
    animation: blink 2s infinite;
  }

  /* ---------- STATS PREVIEW ---------- */
  .stats-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 3rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 1.8rem;
    transition: border-color .3s, box-shadow .3s;
  }
  .stat-card:hover {
    border-color: var(--green);
    box-shadow: 0 0 16px var(--glow);
  }
  .stat-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: .8rem;
  }
  .stat-label { font-size: .38rem; color: var(--text-dim); letter-spacing: 1px; }
  .stat-arrows { font-size: .45rem; color: var(--text-dim); }
  .stat-value { font-size: 1.6rem; margin-bottom: .6rem; }
  .stat-desc { font-size: .82rem; color: var(--text-dim); line-height: 1.5; }

  /* ---------- SECTIONS ---------- */
  .section {
    padding: 5rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-header { margin-bottom: 3rem; }
  .section-tag {
    font-size: .35rem; color: var(--text-dim);
    margin-bottom: .6rem; letter-spacing: 1px;
  }
  .section-title {
    font-size: 1.6rem; margin-bottom: .6rem;
    color: var(--green);
    text-shadow: 0 0 10px var(--glow);
  }
  .section-sub { font-size: .9rem; color: var(--text-dim); }

  /* ---------- QUESTS GRID ---------- */
  .quests-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .quest-card {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 1.8rem;
    transition: all .3s;
    animation: fadeup .6s ease both;
  }
  .quest-card:nth-child(2) { animation-delay: .1s; }
  .quest-card:nth-child(3) { animation-delay: .2s; }
  .quest-card:nth-child(4) { animation-delay: .3s; }
  .quest-card:hover {
    border-color: var(--green);
    box-shadow: 0 0 16px var(--glow);
    transform: translateY(-3px);
  }
  .quest-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
  .quest-id { font-size: .32rem; color: var(--text-dim); letter-spacing: 1px; }
  .quest-year { font-size: .32rem; color: var(--text-dim); letter-spacing: 1px; }
  .quest-title { font-size: .55rem; color: var(--green); margin-bottom: .8rem; letter-spacing: 1px; }
  .quest-desc { font-size: .85rem; color: var(--text-dim); line-height: 1.5; margin-bottom: 1rem; }
  .quest-stack { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1rem; }
  .tech-tag {
    font-size: .3rem;
    padding: .25rem .5rem;
    border: 1px solid var(--border);
    color: var(--text-dim);
    letter-spacing: 1px;
  }
  .quest-link { font-size: .38rem; display: block; letter-spacing: 1px; }

  /* ---------- SKILLS ---------- */
  .skills-groups {
    display: flex; flex-direction: column; gap: 2.5rem;
  }
  .skill-group-label {
    font-size: .5rem; color: var(--green); margin-bottom: 1rem;
    letter-spacing: 2px;
    text-shadow: 0 0 8px var(--glow);
  }
  .skill-tags {
    display: flex; flex-wrap: wrap; gap: .6rem;
  }
  .skill-tag {
    font-size: .4rem;
    padding: .5rem .9rem;
    border: 1px solid var(--border);
    color: var(--text);
    letter-spacing: 1px;
    transition: all .3s;
  }
  .skill-tag:hover {
    border-color: var(--green);
    color: var(--green);
    box-shadow: 0 0 12px var(--glow);
  }

  /* ---------- CONTACT ---------- */
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
  }
  .contact-info { display: flex; flex-direction: column; gap: 1.5rem; }
  .ci-item { display: flex; flex-direction: column; gap: .3rem; }
  .ci-lbl { font-size: .5rem; color: var(--text-dim); letter-spacing: 1px; }
  .ci-val { font-size: .55rem; }

  .contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
  .form-label { font-size: .5rem; color: var(--text-dim); margin-bottom: .4rem; display: block; letter-spacing: 1px; }
  .form-input {
    width: 100%;
    padding: .8rem 1rem;
    background: var(--bg2);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .form-input:focus {
    border-color: var(--green);
    box-shadow: 0 0 10px var(--glow);
  }
  .form-input::placeholder { color: var(--text-dim); }
  .form-textarea { min-height: 120px; resize: vertical; }

  /* ---------- FOOTER ---------- */
  .footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 2rem;
    border-top: 1px solid var(--border);
    background: rgba(13,10,24,0.8);
  }
  .ft-left, .ft-right { font-size: .32rem; color: var(--text-dim); }
  .ft-links { display: flex; gap: 1.5rem; }
  .ft-link {
    font-size: .38rem; color: var(--text);
    transition: color .2s, text-shadow .2s;
    letter-spacing: 1px;
  }
  .ft-link:hover {
    color: var(--green);
    text-shadow: 0 0 8px var(--glow);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      padding: 6rem 1.5rem 2rem;
      text-align: center;
    }
    .hero-content { max-width: 100%; }
    .hero-desc { border-left: none; padding-left: 0; }
    .hero-buttons { justify-content: center; }
    .breadcrumb { justify-content: center; }
    .hero-avatar { margin-top: 2rem; }
    .avatar-frame { width: 200px; height: 230px; margin: 0 auto; }
    .status-badge { right: -10px; bottom: -8px; }

    .stats-preview {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
    }
    .quests-grid { grid-template-columns: 1fr; }
    .section { padding: 3rem 1.5rem; }
    .contact-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-title { font-size: 1.6rem; }
    .section-title { font-size: 1rem; }

    .footer { flex-direction: column; gap: .6rem; text-align: center; }
  }
</style>
