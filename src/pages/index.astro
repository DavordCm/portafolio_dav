<script>
  // ========== BOOT SCREEN ==========
  const bootLines = [
    { text: 'Connecting to portfolio.dev...', delay: 140 },
    { text: 'Loading React modules...',       delay: 140 },
    { text: 'Initializing Node.js runtime...', delay: 140 },
    { text: 'Syncing MySQL database...',      delay: 140 },
    { text: 'Compiling assets...',            delay: 120 },
    { text: 'Ready.',                         delay: 100 },
  ];
  const bootEl = document.getElementById('bootscreen');
  const bootOut = document.getElementById('bootOutput');
  const skipBoot = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function typeLine(line, container) {
    return new Promise((resolve) => {
      const lineEl = document.createElement('div');
      lineEl.className = 'bootscreen__line';
      const prompt = document.createElement('span');
      prompt.className = 'bootscreen__prompt';
      prompt.textContent = '>';
      const text = document.createElement('span');
      text.className = 'bootscreen__text';
      const cursor = document.createElement('span');
      cursor.className = 'bootscreen__cursor bootscreen__cursor--visible';
      lineEl.append(prompt, text, cursor);
      container.appendChild(lineEl);
      let i = 0;
      const tick = () => {
        if (i <= line.length) {
          text.textContent = ' ' + line.slice(0, i);
          i++;
          setTimeout(tick, 8 + Math.random() * 10);
        } else {
          cursor.remove();
          resolve();
        }
      };
      tick();
    });
  }

  async function runBoot() {
    if (skipBoot) { bootEl?.remove(); document.body.classList.add('booted'); startHeroTyper(); return; }
    document.body.style.overflow = 'hidden';
    for (const l of bootLines) {
      await typeLine(l.text, bootOut);
      await new Promise((r) => setTimeout(r, l.delay));
    }
    await new Promise((r) => setTimeout(r, 200));
    bootEl?.classList.add('bootscreen--out');
    // Start hero typer in parallel with boot fade-out so it's already
    // typing by the time the boot screen disappears.
    document.body.style.overflow = '';
    document.body.classList.add('booted');
    startHeroTyper();
    setTimeout(() => bootEl?.remove(), 600);
  }

  // ========== HERO CODE TYPEWRITER ==========
  const codeLines = [
    [['k','import'],['p',' express '],['k','from'],['p',' '],['s','"express"']],
    [['k','const'],['p',' app '],['p','= '],['f','express'],['p','();']],
    [],
    [['f','app'],['p','.'],['f','get'],['p','('],['s','"/work"'],['p',', (req, res) '],['k','=>'],['p',' {']],
    [['p','  '],['f','res'],['p','.'],['f','json'],['p','({']],
    [['p','    '],['f','message'],['p',': '],['s','"Listo para construir algo grande"']],
    [['p','  });']],
    [['p','});']],
  ];
  const tokenClass = { k:'syntax-keyword', f:'syntax-function', s:'syntax-string', d:'syntax-decorator', p:'syntax-plain' };

  function startHeroTyper() {
    const out = document.getElementById('codeOutput');
    const cursor = document.getElementById('codeCursor');
    if (!out) return;

    // Always animate the hero typer — it's a key part of the design.
    // Build DOM with all line numbers + token spans + per-char spans (initially empty).
    out.innerHTML = '';
    /** @type {{el: HTMLElement, ch: string, isLineEnd: boolean}[]} */
    const charSlots = [];

    codeLines.forEach((line, lineIdx) => {
      const lineNum = document.createElement('span');
      lineNum.className = 'line-number';
      lineNum.textContent = String(lineIdx + 1);
      out.appendChild(lineNum);

      let lastSlotInLine = null;
      line.forEach(([type, txt]) => {
        const tokenSpan = document.createElement('span');
        tokenSpan.className = tokenClass[type];
        for (const ch of txt) {
          const charSpan = document.createElement('span');
          charSpan.textContent = '';
          tokenSpan.appendChild(charSpan);
          const slot = { el: charSpan, ch, isLineEnd: false };
          charSlots.push(slot);
          lastSlotInLine = slot;
        }
        out.appendChild(tokenSpan);
      });
      if (lastSlotInLine) lastSlotInLine.isLineEnd = true;
      out.appendChild(document.createElement('br'));
    });

    // Move cursor inside the code so it can follow the typing position.
    if (cursor) {
      cursor.classList.add('code-cursor--blink');
      out.insertBefore(cursor, out.firstChild);
    }

    let i = 0;
    function typeNext() {
      if (i >= charSlots.length) {
        // Done — cursor stays right after the last char and keeps blinking.
        cursor?.classList.add('code-cursor--idle');
        return;
      }
      const slot = charSlots[i];
      slot.el.textContent = slot.ch;

      // Move cursor right after this char
      if (cursor && slot.el.parentNode) {
        slot.el.parentNode.insertBefore(cursor, slot.el.nextSibling);
      }

      i++;

      // Variable typing speed for natural rhythm
      let delay;
      if (/\s/.test(slot.ch)) delay = 6 + Math.random() * 8;
      else if (/[(){}[\]]/.test(slot.ch)) delay = 35 + Math.random() * 30;
      else if (/[;,.]/.test(slot.ch)) delay = 45 + Math.random() * 35;
      else delay = 22 + Math.random() * 30;

      if (slot.isLineEnd) delay += 180; // small pause at end of each line

      setTimeout(typeNext, delay);
    }
    setTimeout(typeNext, 80);
  }

  function renderAllInstant() {
    const out = document.createElement('div');
    codeLines.forEach((line, i) => {
      const ln = document.createElement('span');
      ln.className = 'line-number';
      ln.textContent = String(i + 1);
      out.appendChild(ln);
      line.forEach(([t, txt]) => {
        const s = document.createElement('span');
        s.className = tokenClass[t];
        s.textContent = txt;
        out.appendChild(s);
      });
      out.appendChild(document.createElement('br'));
    });
    return out.innerHTML;
  }

  // ========== NAVBAR SCROLL ==========
  const navbar = document.getElementById('navbar');
  const onScroll = () => {
    if (!navbar) return;
    if (window.scrollY > 30) navbar.classList.add('navbar--scrolled');
    else navbar.classList.remove('navbar--scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ========== ACTIVE LINK ON SCROLL ==========
  const navLinks = document.querySelectorAll('.navbar__link');
  const sectionEls = document.querySelectorAll('section[id]');
  const linkObserver = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        const id = e.target.id;
        navLinks.forEach((l) => {
          l.classList.toggle('navbar__link--active', l.getAttribute('href') === '#' + id);
        });
      }
    });
  }, { threshold: 0.35 });
  sectionEls.forEach((s) => linkObserver.observe(s));

  // ========== MOBILE MENU ==========
  const burger = document.getElementById('burger');
  const mobile = document.getElementById('mobileMenu');
  burger?.addEventListener('click', () => {
    burger.classList.toggle('navbar__burger--open');
    mobile?.classList.toggle('navbar__mobile--open');
  });
  document.querySelectorAll('.navbar__mobile-link').forEach((l) => {
    l.addEventListener('click', () => {
      burger?.classList.remove('navbar__burger--open');
      mobile?.classList.remove('navbar__mobile--open');
    });
  });

  // ========== SMOOTH SCROLL ==========
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', window.location.pathname);
      }
    });
  });

  // ========== REVEAL ON SCROLL ==========
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

  // Apply reveal class + stagger delays AND observe (correct order!)
  const revealEls = document.querySelectorAll(
    '.section-header, .about__main, .about__stat, .projects__card, .education__card, .skills__group, .skills__primary, .contact__info, .contact__form'
  );
  revealEls.forEach((el, i) => {
    el.classList.add('reveal-target');
    el.style.transitionDelay = (i % 4) * 80 + 'ms';
    io.observe(el);
  });

  // Safety net: any reveal-target still hidden after 1.5s gets shown
  // (covers elements that load above the fold without ever intersecting)
  setTimeout(() => {
    document.querySelectorAll('.reveal-target:not(.is-visible)').forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight) el.classList.add('is-visible');
    });
  }, 1500);

  // Hero entrance (no scroll dependency)
  document.querySelectorAll('.hero__content > *, .hero__terminal').forEach((el, i) => {
    el.classList.add('hero-in');
    el.style.animationDelay = 0.15 + i * 0.12 + 's';
  });

  // ========== COUNTER ANIMATION (stats) ==========
  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
  function animateCount(el, target, suffix, duration = 1400) {
    const t0 = performance.now();
    function tick(now) {
      const p = Math.min(1, (now - t0) / duration);
      const value = Math.floor(easeOutCubic(p) * target);
      el.textContent = value + suffix;
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = target + suffix;
    }
    requestAnimationFrame(tick);
  }
  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target;
      if (el.dataset.counted === '1') return;
      el.dataset.counted = '1';
      const raw = (el.textContent || '').trim();
      const match = raw.match(/^(\d+)(\D*)$/);
      if (!match) return;
      const target = parseInt(match[1], 10);
      const suffix = match[2] || '';
      el.textContent = '0' + suffix;
      animateCount(el, target, suffix);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.about__stat-value').forEach((el) => countObserver.observe(el));

  // Start boot
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runBoot);
  } else {
    runBoot();
  }
</script>

