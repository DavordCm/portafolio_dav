---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: "01",
    title: "AKTIVA Energy Bars",
    year: "2025",
    role: "Full Stack Developer · Freelance",
    desc: "Tienda web completa para venta de barras energéticas andinas. Sistema de roles (cliente y empleado), carrito con filtros dinámicos, pasarela de pagos integrada (Yape QR, PayPal, tarjeta), panel admin con reportes PDF/CSV y conversión automática soles/dólares.",
    stack: ["React", "JavaScript", "CSS", "Netlify"],
    link: "https://projecto-aktiva.netlify.app/",
    repos: [{ label: "Código", url: "https://github.com/DavordCm/proyecto_AKTIVA" }],
  },
  {
    id: "02",
    title: "LavaYa — Lavandería Express",
    year: "2025",
    role: "Full Stack Developer · Freelance",
    desc: "Plataforma web de lavandería con recojo y entrega a domicilio. Gestión de atención al cliente, seguimiento de pedidos en tiempo real y programación flexible de horarios. Interfaz centrada en rapidez y confianza.",
    stack: ["React", "Tailwind CSS", "Netlify"],
    link: "https://lavaya.netlify.app/",
    repos: [{ label: "Código", url: "https://github.com/DavordCm/Lavaya" }],
  },
  {
    id: "03",
    title: "Sistema de Fiscalización Vehicular — Muni Chorrillos",
    year: "2024 — 2025",
    role: "Full Stack Developer · Freelance",
    desc: "Sistema web para la Municipalidad de Chorrillos. Backend con rutas seguras (JWT y control de roles), API REST con CRUD completo sobre MySQL, integrado con frontend en React para la gestión de vehículos e infracciones.",
    stack: ["React", "Node.js", "Express", "Spring Boot", "MySQL", "JWT", "Git"],
    link: "",
    repos: [
      { label: "Frontend", url: "https://github.com/DavordCm/react_munichorrillos" },
      { label: "Backend",  url: "https://github.com/DavordCm/ec3" },
    ],
  },
  {
    id: "04",
    title: "Sistema Corporativo — Gestión de Multas",
    year: "2024",
    role: "Full Stack Developer · Colaboración",
    desc: "Sistema CRUD para administración y registro de multas e infracciones, desarrollado en equipo. Optimización del acceso a datos, automatización de procesos repetitivos y generación de reportes dinámicos con SQL Server.",
    stack: ["C#", "ASP.NET", "SQL Server"],
    link: "",
    repos: [{ label: "Código", url: "https://github.com/AlexCarbajoG/SistemaCorporativo2" }],
  },
];

const primarySkills = ["React", "Node.js", "Express", "Spring Boot", "ASP.NET", "MySQL"];
const skillGroups = [
  { label: "Frontend",  skills: ["React", "Angular", "Astro", "HTML", "CSS", "Tailwind CSS", "Bootstrap", "Material UI", "JavaScript"] },
  { label: "Backend",   skills: ["Node.js", "Express.js", "Spring Boot", "ASP.NET"] },
  { label: "Lenguajes", skills: ["JavaScript", "Java", "Python", "C#"] },
  { label: "Bases de datos", skills: ["MySQL", "SQL Server", "SQLite"] },
  { label: "Herramientas", skills: ["Git", "GitHub", "Postman", "GitHub Copilot", "VS Code", "Netlify"] },
  { label: "Metodologías", skills: ["Full Stack", "APIs REST", "CRUD", "Autenticación JWT"] },
];

const education = [
  {
    period: "Abril 2026 — Presente",
    title: "Ingeniería de Sistemas",
    institution: "Universidad Peruana de Ciencias Aplicadas — UPC",
    desc: "Carrera en curso. Formación en arquitectura de software, gestión de proyectos y desarrollo profesional.",
  },
  {
    period: "2023 — 2025",
    title: "Desarrollo de Sistemas de Información",
    institution: "Instituto de Educación Superior Tecnológico IDAT",
    desc: "Egresado. Bases de datos, programación orientada a objetos, desarrollo web full stack y despliegue en producción.",
  },
];

const languages = [
  { name: "Español", level: "Nativo" },
  { name: "Inglés",  level: "Intermedio" },
];
